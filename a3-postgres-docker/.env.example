# Copy to .env and change the password:  cp .env.example .env
# Used by docker compose (db credentials + api connection string)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used when running the API directly on your machine (uvicorn main:app),
# pointing at the Postgres container's published port. Keep the password in sync.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/tasks
